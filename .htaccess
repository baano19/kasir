RewriteEngine On

# 1. Paksa hapus .php dari URL (Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Kasih izin akses file .php secara internal
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 3. Proteksi Database
<Files "*.db">
    Order allow,deny
    Deny from all
</Files>
