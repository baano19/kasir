* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}
input, button, select {
    font-family: inherit;
}

:root { 
    --bg: #121212; --card: #1e1e1e; --primary: #bb86fc; 
    --text: #e0e0e0; --accent: #03dac6; --danger: #cf6679; 
}

/* ==========================================================================
   RESET & LAYOUT DASAR
   ========================================================================== */
a { text-decoration: none !important; }

body { 
    font-family: "Segoe UI", sans-serif; background: var(--bg); color: var(--text); 
    margin: 0; display: flex; min-height: 100vh; overflow-x: hidden;
}

.content { flex-grow: 1; padding: 30px; width: 100%; box-sizing: border-box; overflow-x: hidden; }

/* ==========================================================================
   HEADER MOBILE & SIDEBAR
   ========================================================================== */
.mobile-header {
    display: none; position: fixed; top: 0; left: 0; right: 0;
    background: #1a1a1a; padding: 15px 20px; z-index: 1100; border-bottom: 1px solid #333;
    justify-content: space-between; align-items: center;
}
.burger-btn { 
    background: transparent !important; border: none !important; 
    color: var(--primary) !important; font-size: 2rem !important; 
    cursor: pointer !important; width: auto !important; padding: 0 !important; 
}

.sidebar { width: 240px; background: var(--card); padding: 20px; border-right: 1px solid #333; flex-shrink: 0; transition: left 0.3s ease; z-index: 1200; }
.sidebar h2 { color: var(--primary); margin-bottom: 30px; margin-top: 0; }
.sidebar a { display: block; color: #fff !important; padding: 12px; border-radius: 8px; margin-bottom: 10px; transition: 0.2s; }
.sidebar a.active { background: var(--primary) !important; color: #000 !important; font-weight: bold; }

/* ==========================================================================
   KOMPONEN UMUM (CARDS, TABLES, INPUT)
   ========================================================================== */
.card { background: var(--card); padding: 20px; border-radius: 12px; margin-bottom: 20px; border-left: 5px solid var(--primary); width: 100%; box-sizing: border-box; }
.table-container { width: 100%; overflow-x: auto; background: var(--card); border-radius: 12px; -webkit-overflow-scrolling: touch; }
table { width: 100%; border-collapse: collapse; min-width: 650px; }
th, td { padding: 12px; text-align: left; border-bottom: 1px solid #333; font-size: 0.9rem; }
th { background: #252525; color: var(--primary); font-size: 0.85rem; }

input, select, textarea { 
    width: 100% !important; background-color: #252525 !important; 
    color: #fff !important; border: 1px solid #444 !important; 
    padding: 10px !important; border-radius: 8px !important; margin: 5px 0 !important;
    box-sizing: border-box;
}

/* ==========================================================================
   TOMBOL (BUTTONS), TABS, PAGINATION
   ========================================================================== */
button { background: var(--primary) !important; color: #000 !important; font-weight: bold !important; padding: 10px 20px !important; border-radius: 8px !important; cursor: pointer; border: none !important; width: auto !important; transition: 0.2s; }
button:hover { opacity: 0.9; }

.btn-edit { background: var(--accent) !important; color: #000 !important; padding: 6px 12px; border-radius: 6px; font-weight: bold; font-size: 0.8rem; }
.btn-cancel { background: #444 !important; color: #fff !important; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; }
button.del, .btn-del { background-color: var(--danger) !important; color: white !important; border: none !important; padding: 6px 12px !important; border-radius: 6px !important; font-weight: bold !important; cursor: pointer; }

.tabs { display: flex !important; gap: 10px !important; margin-bottom: 20px !important; border-bottom: 1px solid #333 !important; padding-bottom: 15px !important; flex-wrap: wrap !important; }
.tabs a, .tabs button { flex: 1; min-width: 140px; text-align: center; padding: 12px 15px !important; border-radius: 8px !important; font-size: 0.9rem !important; border: none; cursor: pointer; display: block !important; background: #1e1e1e !important; color: #aaa !important; transition: all 0.2s ease; }
.tabs a:hover, .tabs button:hover { background: #2a2a2a !important; color: #fff !important; }
.tabs a.active, .tabs button.active { background: var(--primary) !important; color: #000 !important; font-weight: bold !important; }

.pagination { display: flex !important; flex-wrap: nowrap !important; overflow-x: auto !important; gap: 5px !important; margin-top: 20px !important; padding-bottom: 10px !important; justify-content: flex-start !important; width: 100%; -webkit-overflow-scrolling: touch; }
.pagination a { padding: 5px 10px !important; background: #252525 !important; color: #fff !important; border-radius: 8px !important; border: 1px solid #444 !important; font-weight: bold !important; font-size: 0.85rem; white-space: nowrap !important; flex-shrink: 0 !important; transition: all 0.2s ease; }
.pagination a:not(.active):hover { background: #333 !important; }
.pagination a.active { background: var(--primary) !important; color: #000 !important; border-color: var(--primary) !important; }
.pagination span.dots { padding: 5px 2px !important; color: #888 !important; background: transparent !important; border: none !important; font-weight: bold !important; }

/* ==========================================================================
   DASHBOARD SPECIFIC STYLES
   ========================================================================== */
.dash-container * { box-sizing: border-box; }
.dash-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 25px; width: 100%; }
.dash-title { margin: 0; color: var(--primary); font-size: 1.8rem; }
.dash-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; width: auto; }
.filter-form { display: flex; flex-direction: row; gap: 10px; align-items: center; }
.dash-select { width: auto !important; min-width: 130px; display: inline-block !important; padding: 10px 15px !important; border-radius: 8px !important; background: #252525 !important; border: 1px solid #444 !important; color: white !important; font-size: 0.9rem; }

.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 25px; width: 100%; }

/* FIX PRESISI: Ditambahin display flex biar isi content-nya center otomatis */
.kpi-card { 
    background: var(--card); border: 1px solid #333; border-radius: 12px; 
    padding: 20px; position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
}
.kpi-card h3 { font-size: 0.85rem; color: #888; text-transform: uppercase; margin: 0 0 8px 0; letter-spacing: 0.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kpi-card .val { font-size: clamp(1.4rem, 4vw, 1.8rem); font-weight: 700; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* FIX PRESISI: Margin bottom dihapus biar tingginya rata di Grid */
.kpi-highlight { border-bottom: 3px solid var(--primary); }
.kpi-highlight-accent { border-bottom: 3px solid var(--accent); }

.chart-container { position: relative; height: 300px; width: 100%; }

.action-btns { display: flex; gap: 10px; }
.btn-dash { display: inline-flex !important; justify-content: center; align-items: center; gap: 8px; font-size: 0.9rem; white-space: nowrap; padding: 10px 18px !important; border-radius: 8px !important; font-weight: bold; border: none; cursor: pointer; }

/* Dialog / Modal */
dialog { background: var(--card); color: #fff; border: 1px solid #333; border-radius: 12px; padding: 25px; width: 95%; max-width: 450px; box-shadow: 0 20px 40px rgba(0,0,0,0.7); }
dialog::backdrop { background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); }
.dialog-title { margin-top: 0; font-size: 1.2rem; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
.fg { margin-bottom: 15px; text-align: left; }
.fg label { display: block; font-size: 0.8rem; color: #888; margin-bottom: 5px; }
.fg select, .fg input { width: 100% !important; display: block !important; box-sizing: border-box; }

/* Dash Table */
.table-wrap { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 10px; }
.dash-table { width: 100%; min-width: 500px; margin-top: 5px; border-collapse: collapse; }
.dash-table th { text-align: left; color: #888; font-size: 0.75rem; text-transform: uppercase; padding: 12px 10px; border-bottom: 1px solid #333; white-space: nowrap; }
.dash-table td { padding: 15px 10px; border-bottom: 1px solid #2a2a2a; font-size: 0.95rem; white-space: nowrap; }

/* FIX PRESISI: !important ditambahin biar 'th' bawaan kalah sama class rata kanan ini */
.num-col { text-align: right !important; font-variant-numeric: tabular-nums; }

/* UTILITY CLASSES */
.text-primary { color: var(--primary) !important; }
.text-accent { color: var(--accent) !important; }
.text-danger { color: var(--danger) !important; }
.fw-bold { font-weight: bold !important; }
.mb-0 { margin-bottom: 0 !important; }
.mb-25 { margin-bottom: 25px !important; }
.mt-8 { margin-top: 8px !important; }
.d-block { display: block !important; }
.fs-sm { font-size: 0.8rem !important; }
.flex-row-gap { display: flex; gap: 10px; }
.flex-1 { flex: 1; }

.btn-primary { background: var(--primary) !important; color: #000 !important; }
.btn-danger { background: var(--danger) !important; color: #fff !important; }
.btn-accent { background: var(--accent) !important; color: #000 !important; }
.btn-secondary { background: #252525 !important; border: 1px solid #444 !important; color: #fff !important; }

/* Sidebar Override Merah */
.sidebar a.logout-link { color: var(--danger) !important; font-weight: bold; }
.sidebar a.logout-link:hover { background: var(--danger) !important; color: #fff !important; }

/* WRAPPER KHUSUS RANGE TANGGAL */
.date-range-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
}
/* ==========================================================================
   LOGIN PAGE
   ========================================================================== */
body.login-page {
    display: flex !important; justify-content: center !important; align-items: center !important;
    flex-direction: column !important; margin: 0 !important; padding: 0 !important;
    min-height: 100vh !important; background-color: var(--bg);
}
.login-card {
    width: 90% !important; max-width: 380px !important; padding: 40px 35px !important;
    text-align: center; border-left: none !important; border-top: 5px solid var(--primary) !important; 
    box-shadow: 0 15px 35px rgba(0,0,0,0.6); border-radius: 12px !important; box-sizing: border-box !important;
}
.login-card h2 { color: var(--primary); margin-top: 0; margin-bottom: 35px; font-size: 2rem; letter-spacing: 1px; }
.login-error { color: var(--danger); margin-top: 20px; font-weight: bold; font-size: 0.9rem; }

/* --- 1. Fix Untuk Modal/Dialog "Export Laporan" (image_23.png) --- */

/* Class khusus buat Judul Modal Laporan biar Lurus Kiri sama label di bawah */
.export-laporan-title {
    margin-left: 0 !important; /* Paksa reset margin kiri biar nggak menjorok */
    padding-left: 10px !important; /* Samain padding kirinya sama label input di bawah */
    color: #bb86fc; /* Warna ungu-nya tetap */
    font-size: 1.2rem;
    font-weight: bold;
    margin-bottom: 15px; /* Jarak napas ke label di bawah */
}

/* Fix Label Abu-abu kejepit biar ada jarak napas ke Input Field di bawahnya */
.modal-body label {
    display: block;
    color: #888; /* Warna abu-abu label */
    font-size: 0.8rem;
    margin-bottom: 5px !important; /* Kasih jarak napas presisi ke input field */
    margin-left: 10px; /* Padding kiri seragam */
}


/* --- 2. Fix Untuk Dropdown Filter Depan (image_24.png) --- */

/* TARGET UTAMA: Kontainer select dropdown biar SEMUA ISI di tengah secara VERTIKAL */
.filter-form select,
.input-new-trans-card select {
    display: flex !important; /* Aktifin mode Flexbox */
    align-items: center !important; /* <--- INI KUNCINYA: Paksa ikon, teks, panah sejajar VERTIKAL DI TENGAH */
    height: 42px !important; /* Set tinggi seragam */
    padding: 0 15px !important; /* Padding kanan kiri lurus */
    background: #252525 !important;
    border: 1px solid #444 !important;
    color: #fff !important;
    border-radius: 8px !important;
    box-sizing: border-box;
    /* Hilangkan panah default browser biar kita yang atur */
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    /* Tambahkan panah kustom yang lebih centered (jika perlu) atau pastikan panah bawaan centered */
}

/* Khusus target ikon Globe di dalem select "Semua Cabang" biar nggak kabur ke atas */
.filter-form select option[value="all"],
.filter-form select .icon-globe {
    margin-top: 0 !important; /* Reset margin atas ikon melayang */
    display: flex;
    align-items: center; /* Sejajarin ikon globe secara vertikal di tengah teks */
}

/* ==========================================================================
   🍎 FIX KHUSUS IPHONE / iOS SAFARI 🍎
   ========================================================================== */
@supports (-webkit-touch-callout: none) {
    
    /* 1. Mencegah auto-zoom Apple yang sering merusak layout */
    input, select, textarea {
        font-size: 16px !important; 
    }

    /* 2. Fix Teks & Emoji (🌍) yang mencong/kegencet di Dropdown Select */
    select, .dash-select {
        height: 44px !important;
        line-height: 44px !important; /* Paksa teks rata tengah vertikal */
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        vertical-align: middle !important;
        display: block !important; /* Safari benci display:flex pada select */
        -webkit-appearance: none !important; /* Buang style bawaan iOS */
    }

    /* 3. Fix Input Tanggal (Kalender) yang penyok di Modal Export */
    input[type="date"] {
        height: 44px !important;
        line-height: 44px !important;
        padding: 0 15px !important;
        display: block !important;
        -webkit-appearance: none !important; 
        background-color: #252525 !important;
        color: #fff !important;
    }

    /* 4. Fix Modal Dialog yang padding/marginnya ngaco di iOS Safari */
    dialog {
        padding: 25px 20px !important;
        box-sizing: border-box !important;
    }
    
    .dialog-title {
        margin-top: 0 !important;
        margin-bottom: 25px !important;
        padding: 0 !important;
        line-height: 1.2 !important;
    }

    .fg {
        margin-bottom: 20px !important; /* Paksa jarak antar input di dalam modal */
    }
    
    .fg label {
        margin-bottom: 8px !important; /* Jarak label ke input */
        display: block !important;
    }

    /* 5. Fix tombol dalam modal yang tumpang tindih */
    .dialog-actions {
        display: flex !important;
        flex-direction: column !important; /* Paksa tumpuk vertikal biar rapi di HP */
        gap: 12px !important;
        width: 100% !important;
        margin-top: 25px !important;
    }
    
    .dialog-actions button {
        width: 100% !important;
        margin: 0 !important; /* Reset margin karena udah pake gap */
        padding: 14px !important;
        font-size: 1rem !important;
    }
}

/* BADGE KHUSUS EXPENSE */
.badge-branch { 
    background: rgba(187,134,252,0.15); 
    color: var(--primary); 
    padding: 4px 10px; 
    border-radius: 6px; 
    font-size: 0.75rem; 
    font-weight: bold; 
    border: 1px solid rgba(187,134,252,0.3); 
    display: inline-block; 
}
/* ==========================================================================
   SUMMARY CARD (MINI REKAP PENGELUARAN)
   ========================================================================== */
.summary-card {
    background: linear-gradient(145deg, var(--card) 0%, #171717 100%);
    border: 1px solid #333;
    border-left: 5px solid var(--danger);
    border-radius: 12px;
    padding: 20px 25px;
    margin-bottom: 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.summary-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(207, 102, 121, 0.15);
}
.summary-label {
    font-size: 0.85rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    font-weight: 600;
}
.summary-total {
    font-size: 2.2rem;
    color: var(--danger);
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.5px;
}

/* ==========================================================================
   TRANSACTION PAGE SPECIFIC UI & UTILITIES
   ========================================================================== */

/* Hilangin Panah di Input Number (Clean UI) */
input[type=number]::-webkit-inner-spin-button, 
input[type=number]::-webkit-outer-spin-button { 
    -webkit-appearance: none; 
    margin: 0; 
}
input[type=number] { 
    -moz-appearance: textfield; 
}

/* Card Modifiers (Warna Border Kiri) */
.card-warning { border-left-color: orange !important; }
.card-accent { border-left-color: var(--accent) !important; }

/* Text & Button Modifiers */
.text-warning { color: orange !important; }
.btn-warning { background: orange !important; color: #000 !important; }
.btn-warning:hover { background: #e69500 !important; }

/* Layout & Input Modifiers */
.bulk-row { 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    background: #252525; 
    padding: 12px 15px; 
    border-radius: 8px; 
    margin-bottom: 8px; 
    border: 1px solid #444; 
}
.input-sm { 
    width: 90px !important; 
    padding: 8px !important; 
    text-align: center;
}
.checkbox-inline { 
    width: 20px !important; 
    margin: 0 10px 0 0 !important; 
    cursor: pointer;
}
.label-checkbox {
    display: flex; 
    align-items: center; 
    cursor: pointer; 
    background: #1a1a1a; 
    padding: 12px 15px; 
    border-radius: 8px;
    border: 1px solid #333;
    transition: 0.2s;
}
.label-checkbox:hover { border-color: var(--accent); }
.flex-between { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
/* ==========================================================================
   TOAST NOTIFICATIONS (FLASH MESSAGES)
   ========================================================================== */
.toast-container {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 15px;
}
.toast {
    min-width: 280px;
    padding: 16px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    background: var(--card);
    color: #fff;
    border-left: 4px solid transparent;
    animation: slideUpToast 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}
.toast-success { border-left-color: var(--accent); }
.toast-error { border-left-color: var(--danger); }

@keyframes slideUpToast {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeOutToast {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(10px); }
}

.toast.hiding { animation: fadeOutToast 0.3s ease forwards; }
/* ==========================================================================
   CAPSTER SUMMARY GRID (PREMIUM COMPACT UI)
   ========================================================================== */
.capster-summary-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px;
    margin-bottom: 25px;
}
.capster-summary-box {
    background: linear-gradient(145deg, #1e1e1e 0%, #151515 100%);
    border: 1px solid #333;
    border-radius: 10px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    border-left: 3px solid var(--primary);
    transition: transform 0.2s ease;
}
.capster-summary-name {
    font-weight: 700;
    color: #fff;
    font-size: 1.05rem;
    margin: 0 0 4px 0;
}
.capster-summary-branch {
    font-size: 0.7rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.capster-summary-total {
    color: var(--accent);
    font-size: 1.4rem;
    font-weight: 800;
    margin: 12px 0 0 0;
    letter-spacing: -0.5px;
}
.capster-summary-count {
    font-size: 0.75rem;
    color: #aaa;
    margin-top: 4px;
}
/* ==========================================================================
   RESPONSIVE KHUSUS HP (MOBILE FIRST GABUNGAN)
   ========================================================================== */
@media (max-width: 768px) {
    /* Layout Dasar HP */
    .mobile-header { display: flex; }
    .sidebar { position: fixed; left: -100%; top: 0; bottom: 0; width: 250px; box-shadow: 2px 0 15px rgba(0,0,0,0.5); }
    .sidebar.active { left: 0; }
    .content { padding: 80px 15px 15px 15px; }
    
    /* Header & Action Buttons */
    .dash-header { flex-direction: column; align-items: stretch; gap: 15px; }
    .dash-actions { width: 100%; flex-direction: column; align-items: stretch; gap: 10px; }
    .action-btns { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .btn-dash { width: 100% !important; padding: 12px 10px !important; }
    
    /* Form & Filter */
    .filter-form { display: flex; flex-direction: column; width: 100%; gap: 10px; }
    .dash-select { width: 100% !important; min-width: 0 !important; }
    .date-range-group { width: 100%; }
    
    /* FIX HP: Paksa Flex Row jadi Column biar input kalender iOS gak offside */
    .flex-row-gap {
        flex-direction: column !important;
        gap: 12px !important;
    }
    .flex-row-gap .flex-1 {
        width: 100% !important;
    }

    /* KPI Cards & Summary */
    .kpi-grid { grid-template-columns: 1fr; gap: 12px; }
    .kpi-card { padding: 15px; }
    .summary-card { padding: 15px 20px; }
    .summary-total { font-size: 1.8rem; }
    
    /* Sihir Khusus Mobile: Ubah Kotak Vertikal jadi Horizontal List */
    .capster-summary-wrapper {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    
    .capster-summary-box {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-rows: auto auto;
        padding: 14px 16px;
        align-items: center;
        row-gap: 2px;
    }

    .capster-summary-name { grid-column: 1; grid-row: 1; font-size: 0.95rem; margin: 0; }
    .capster-summary-branch { grid-column: 1; grid-row: 2; font-size: 0.65rem; }
    
    .capster-summary-total { grid-column: 2; grid-row: 1; font-size: 1.1rem; margin: 0; text-align: right; }
    .capster-summary-count { grid-column: 2; grid-row: 2; font-size: 0.7rem; text-align: right; margin: 0; }
}
/* ==========================================================================
   FIX TUNTAS: IPHONE DATETIME KOSONG & TABEL KOPONG
   ========================================================================== */

/* 1. OBAT BUG SAFARI: Fix Input Tanggal Blank di iPhone */
input[type="datetime-local"],
input[type="date"] {
    color: #fff !important;
    background-color: #252525 !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    display: block !important;
    width: 100% !important;
    min-height: 42px !important;
    padding: 10px 15px !important;
    box-sizing: border-box !important;
    line-height: normal !important; /* INI KUNCI UTAMANYA: Safari iOS benci line-height di kalender */
}
input[type="datetime-local"]::-webkit-datetime-edit,
input[type="date"]::-webkit-datetime-edit {
    color: #fff !important;
    line-height: normal !important;
}

/* 2. FIX TABEL KOPONG: Bikin Gross & Waktu Rata Kiri biar nempel rapi */
.dash-table { 
    width: 100%; 
    table-layout: auto; 
}
/* Paksa angka di tabel transaksi rata kiri biar gak kabur ke ujung kanan monitor */
.dash-table th.num-col, 
.dash-table td.num-col,
.col-gross, 
.col-waktu {
    text-align: left !important;
    padding-right: 15px !important;
}
/* Reset paksaan width yang kemaren */
.col-service, .col-gross, .col-waktu, .col-aksi { 
    width: auto !important; 
    min-width: 0 !important; 
}

/* 3. FIX FORM ROW (Aman di Desktop, Numpuk Rapi di HP) */
.flex-row-gap { 
    display: flex; 
    gap: 15px; 
    width: 100%;
}
.flex-1 { flex: 1; }

@media (max-width: 768px) {
    .flex-row-gap {
        flex-direction: column !important;
        gap: 12px !important;
    }
}
/* ==========================================================================
   PREMIUM FORM LAYOUT & INTERACTIONS
   ========================================================================== */

/* Transisi halus & Efek Glow pas input diklik (Premium Feel) */
input, select, textarea {
    transition: all 0.3s ease !important;
}
input:focus, select:focus, textarea:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 3px rgba(187,134,252,0.15) !important;
    outline: none !important;
}

/* Form Grid System (Biar gak kepanjangan di Desktop) */
.form-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-bottom: 15px;
}
.form-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-bottom: 15px;
}

/* Reset margin bawah khusus dalam grid biar rata */
.form-grid-2 .fg, .form-grid-3 .fg { margin-bottom: 0 !important; }

/* Filter Container Khusus (Lebih ringkas) */
.filter-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr auto;
    gap: 15px;
    align-items: center;
}

/* ==========================================================================
   RESPONSIVE KHUSUS HP (Update untuk Grid Form)
   ========================================================================== */
@media (max-width: 768px) {
    /* Patahkan grid jadi 1 kolom di HP */
    .form-grid-2, .form-grid-3, .filter-wrapper {
        grid-template-columns: 1fr;
    }
    .filter-wrapper .action-btns {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }
}
/* ==========================================================================
   UX ENHANCEMENTS (DATE PICKER, BREAKDOWN, COMPACT FILTER)
   ========================================================================== */

/* 1. HACK: Bikin seluruh area kotak Input Tanggal bisa di-klik (Gak cuma ikonnya) */
input[type="datetime-local"], 
input[type="date"] {
    position: relative;
    cursor: pointer;
}
input[type="datetime-local"]::-webkit-calendar-picker-indicator,
input[type="date"]::-webkit-calendar-picker-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0; /* Sembunyiin ikon aslinya, tapi tetep bisa diklik full */
    cursor: pointer;
}

/* 2. BARBER FILTER: Bikin compact di Desktop biar gak kopong */
.filter-wrapper-barber {
    display: flex;
    align-items: center;
    gap: 15px;
    max-width: 600px; /* Batasin lebarnya biar gak stretching */
}
.filter-wrapper-barber .date-range-group {
    flex: 2;
}
.filter-wrapper-barber .action-btns {
    flex: 1;
}

/* 3. CAPSTER BREAKDOWN: List service di dalam Mini Rekap */
.capster-summary-breakdown {
    margin-top: 15px;
    padding-top: 12px;
    border-top: 1px dashed #333;
    font-size: 0.75rem;
    color: #888;
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.capster-summary-breakdown-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.capster-summary-breakdown-item span:last-child {
    color: var(--text);
    font-weight: 600;
    background: #252525;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.7rem;
}

@media (max-width: 768px) {
    .filter-wrapper-barber {
        flex-direction: column;
        max-width: 100%;
    }
}
/* ==========================================================================
   SETTINGS PAGE UI & TABLE INPUTS
   ========================================================================== */

/* Grid Dinamis untuk Form Tambah Data (Otomatis rapi di PC & HP) */
.form-grid-auto {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    align-items: end;
}

/* Inputan khusus di dalam Tabel biar rapi dan nyatu sama background */
.table-input {
    background: #1a1a1a;
    border: 1px solid #333;
    color: #fff;
    padding: 8px 12px;
    border-radius: 6px;
    width: 100%;
    min-width: 120px;
    font-size: 0.9rem;
    transition: all 0.2s ease;
}
.table-input:focus {
    border-color: var(--primary);
    background: #252525;
    outline: none;
}

/* Grup Aksi di dalam tabel biar sejajar */
.td-action-group {
    display: flex;
    gap: 8px;
    align-items: center;
}

/* Tabel Settings Spacing */
.settings-table th, .settings-table td {
    padding: 12px 15px;
    vertical-align: middle;
}
/* ==========================================================================
   PREMIUM TABLE UX (GHOST INPUTS)
   ========================================================================== */
.ghost-input {
    background: transparent !important;
    border: 1px solid transparent !important;
    color: var(--text) !important;
    padding: 8px 12px !important;
    border-radius: 6px !important;
    width: 100% !important;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.3s ease !important;
}
.ghost-input:hover {
    background: rgba(255, 255, 255, 0.05) !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
}
.ghost-input:focus {
    background: #252525 !important;
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 3px rgba(187,134,252,0.15) !important;
    outline: none !important;
}
select.ghost-input {
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23888' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 10px center;
    background-size: 1em;
}

/* ==========================================================================
   CUSTOM CONFIRMATION MODAL
   ========================================================================== */
.custom-confirm-dialog {
    background: var(--card);
    border: 1px solid #333;
    border-radius: 16px;
    padding: 30px;
    width: 90%;
    max-width: 400px;
    text-align: center;
    box-shadow: 0 25px 50px rgba(0,0,0,0.8);
    transform: scale(0.95);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.custom-confirm-dialog[open] {
    transform: scale(1);
    opacity: 1;
}
.custom-confirm-dialog::backdrop {
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(5px);
}
.confirm-icon {
    font-size: 3rem;
    margin-bottom: 15px;
}
.confirm-title {
    color: #fff;
    margin: 0 0 10px 0;
    font-size: 1.4rem;
}
.confirm-desc {
    color: #aaa;
    font-size: 0.95rem;
    margin: 0 0 25px 0;
    line-height: 1.5;
}
.confirm-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
}
.confirm-actions .btn-dash {
    flex: 1;
    padding: 12px !important;
}
/* ==========================================================================
   COMPACT INLINE FORM (Buat form yang isinya dikit biar elegan)
   ========================================================================== */
.compact-form {
    display: flex;
    align-items: center;
    gap: 15px;
    max-width: 600px;
}
.compact-form .flex-2 { flex: 2; }
.compact-form .flex-1 { flex: 1; }

@media (max-width: 768px) {
    .compact-form { 
        flex-direction: column; 
        max-width: 100%; 
        align-items: stretch;
    }
}
/* ==========================================================================
   ULTIMATE GRID TABLE (ANTI-BUG FORM & RESPONSIVE V2)
   ========================================================================== */
.grid-table { 
    width: 100%; 
    border: 1px solid #333; 
    border-radius: 8px; 
    overflow: hidden; 
    background: var(--card); 
}
.grid-thead { 
    display: grid; 
    background: #151515; 
    padding: 12px 20px; 
    font-size: 0.75rem; 
    font-weight: 800; 
    color: #888; 
    border-bottom: 2px solid #333; 
    letter-spacing: 1px;
    text-transform: uppercase;
}
.grid-tr { 
    display: grid; 
    padding: 15px 20px; 
    border-bottom: 1px solid #333; 
    align-items: center; 
    transition: background 0.2s; 
}
.grid-tr:last-child { border-bottom: none; }
.grid-tr:hover { background: rgba(255,255,255,0.02); }

/* Lebar Kolom Masing-masing Tab (Desktop) */
.gt-cabang { grid-template-columns: 80px 1.5fr 2fr 150px; gap: 20px; }
.gt-layanan { grid-template-columns: 1.5fr 2fr 1fr 150px; gap: 20px; }
.gt-capster { grid-template-columns: 1fr 1.5fr 100px 2fr; gap: 20px; }

/* Ghost Input 2.0 (Lebih Kelihatan Kalo Bisa Diketik) */
.ghost-input {
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    color: var(--text) !important;
    padding: 10px 14px !important;
    border-radius: 8px !important;
    width: 100% !important;
    font-size: 0.9rem;
    transition: all 0.3s ease !important;
}
.ghost-input:hover { border-color: rgba(255, 255, 255, 0.2) !important; }
.ghost-input:focus {
    background: #252525 !important;
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 3px rgba(187,134,252,0.15) !important;
}

/* Zona Keamanan Khusus Capster */
.security-zone {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,0,0,0.3);
    padding: 6px;
    border-radius: 10px;
    border: 1px dashed #444;
}

/* Flex Utilities */
.flex-col-gap { display: flex; flex-direction: column; gap: 8px; }

/* Responsive HP: Ubah Tabel jadi Card Premium */
@media (max-width: 768px) {
    .grid-thead { display: none; }
    .grid-table { border: none; background: transparent; }
    .grid-tr { 
        display: flex; 
        flex-direction: column; 
        background: var(--card); 
        border: 1px solid #333; 
        border-radius: 12px; 
        margin-bottom: 20px; 
        padding: 20px; 
        gap: 15px; 
        align-items: stretch;
    }
    .security-zone { flex-wrap: wrap; padding: 12px; }
    .security-zone .ghost-input { flex: 1 1 100%; }
    .security-zone .btn-dash { flex: 1; }
    .td-action-group { width: 100%; display: flex; gap: 10px; }
    .td-action-group .btn-dash { flex: 1; }
}
/* ==========================================================================
   GROUPED SERVICES UX (HEADER CABANG)
   ========================================================================== */
.branch-group-header {
    background: rgba(187, 134, 252, 0.08);
    color: var(--primary);
    padding: 14px 20px;
    font-size: 0.9rem;
    font-weight: 800;
    border: 1px solid #333;
    border-bottom: none;
    border-radius: 10px 10px 0 0;
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
}
.branch-group-header span {
    font-size: 1.2rem;
}
.grid-table-grouped {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    margin-top: 0;
}

/* Penyesuaian Lebar Kolom (Tanpa Kolom Cabang) */
.gt-layanan-grouped { 
    grid-template-columns: 2.5fr 1fr 150px; 
    gap: 20px; 
}

@media (max-width: 768px) {
    .branch-group-header { 
        border-radius: 10px; 
        border-bottom: 1px solid #333; 
        margin-bottom: 15px;
    }
    .grid-table-grouped { 
        border-top-left-radius: 12px; 
        border-top-right-radius: 12px; 
        background: transparent;
        border: none;
    }
}
